# Editor and OS cruft
.DS_Store
Thumbs.db
*.swp
*~
.vscode/
.idea/

# Audio tooling: the virtualenv, the downloaded voice model (~64 MB) and render
# intermediates. tools/README.md says how to recreate them.
tools/.venv/
tools/models/
tools/build/

# Python bytecode (the renderers import each other, which generates these)
__pycache__/
*.py[cod]

# graphify: the built graph. The derived JS view of our HTML lives outside the
# repo entirely (~/.cache/sortie-graphify), because graphify honors .gitignore and
# would skip the very files it needs to parse. See CLAUDE.md.
graphify-out/
