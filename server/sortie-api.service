[Unit]
Description=Sortie! global leader board API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/sortie-api
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=8791
Environment=DB_PATH=/home/ubuntu/sortie-api/scores.db
ExecStart=/usr/bin/env node /home/ubuntu/sortie-api/server.js
Restart=always
RestartSec=3
# It needs its own directory and nothing else on the box.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/sortie-api
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
